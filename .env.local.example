# ============================================================
# SEMrush Dashboard — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local no Git
# ============================================================

# Sua chave de API do SEMrush (obrigatória)
# Encontre em: https://www.semrush.com/api-analytics/
SEMRUSH_API_KEY=sua_api_key_aqui

# Domínio padrão para análise (opcional — pode ser alterado na UI)
NEXT_PUBLIC_DEFAULT_DOMAIN=seudominio.com.br

# Banco de dados SEMrush (br = Brasil, us = EUA, etc.)
# Lista completa: https://developer.semrush.com/api/basics/databases/
NEXT_PUBLIC_DEFAULT_DATABASE=br

# Intervalo de atualização automática em milissegundos
# 300000 = 5 minutos | 60000 = 1 minuto | 0 = desativado
NEXT_PUBLIC_REFRESH_INTERVAL=300000
